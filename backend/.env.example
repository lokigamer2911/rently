[TEMPLATE]
DATABASE_URL=postgresql://user:password@localhost:5432/rentrex
JWT_SECRET=replace_with_long_random_string
PORT=5000
CLIENT_URL=http://localhost:3000

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payments mode ---------------------------------------------------------
# Set to "true" only once Razorpay is live AND the keys above are filled in.
# While it is false, checkout tells the renter that Razorpay integration is in
# progress and asks them to pay to the UPI QR instead. An admin then confirms
# the credit in /admin -> Payments.
PAYMENTS_RAZORPAY_ENABLED=false

# UPI payees (you + co-founders). Payees are handed out round-robin per booking
# so rent doesn't pile into a single account.
# UPI_PAYEES=[{"vpa":"you@okhdfcbank","name":"Rently","label":"Founder"},{"vpa":"cofounder@ybl","name":"Rently","label":"Co-founder"}]
# Shorthand if you only have one UPI ID:
UPI_VPA=
UPI_PAYEE_NAME=Rently

# Optional: image URL of one of your own UPI QR codes, shown under the generated
# QR as a fallback for apps that won't accept the payee VPA from a deep link.
UPI_STATIC_QR_IMAGE_URL=

# Optional: shown to renters when a payment has to be matched by hand.
PAYMENTS_SUPPORT_CONTACT=

# Messaging
SENDGRID_API_KEY=
EMAIL_FROM=noreply@rentrex.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gemini API Key (for AI-Powered Listing & Pricing Assistant)
GEMINI_API_KEY=
