[TEMPLATE]
[TEMPLATE]
DATABASE_URL=postgresql://user:password@localhost:5432/rentrex
JWT_SECRET=replace_with_long_random_string
PORT=5000
CLIENT_URL=http://localhost:3000

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payments (Razorpay-only, personal account) -----------------------------
# Fill these in with your personal Razorpay test/live keys.
# PAYMENTS_RAZORPAY_ENABLED is no longer used — checkout is Razorpay-only and
# is considered enabled whenever the keys above are present.

# --- Admin access key -------------------------------------------------------
# Second lock on every /api/admin route: the logged-in admin must ALSO present
# this secret (X-Admin-Key header / adminKey body field). Stored only as a
# SHA-256 hash — never put the raw key in the repo.
#   python -c "import secrets; print('rnt_'+secrets.token_urlsafe(30))"
#   python -c "import hashlib; print(hashlib.sha256(b'THE_RAW_KEY').hexdigest())"
ADMIN_KEY_HASH=
# Short public label stamped into admin receipts (optional).
ADMIN_KEY_ID=founder-key-1

# Messaging
SENDGRID_API_KEY=
EMAIL_FROM=noreply@rentrex.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gemini API Key (for AI-Powered Listing & Pricing Assistant)
GEMINI_API_KEY=
