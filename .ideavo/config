{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Frontend Dependencies",
      "command": "npm install --prefix frontend"
    },
    {
      "name": "Install Backend Dependencies",
      "command": "npm install --prefix backend"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Backend Tests",
      "command": "npm test --prefix backend"
    },
    {
      "name": "Run Backend Lint",
      "command": "npm run lint --prefix backend"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Frontend",
      "command": "npm run build --prefix frontend"
    },
    {
      "name": "Generate Prisma Client",
      "command": "npx prisma generate --prefix backend"
    }
  ],
  "runStep": [
    {
      "name": "Run Frontend Dev Server",
      "command": "npm run dev --prefix frontend --port 3000",
      "port": "3000"
    },
    {
      "name": "Run Backend Dev Server",
      "command": "npm run dev --prefix backend --port 5050",
      "port": "5050"
    }
  ],
  "deploySteps": [
    {
      "name": "Start Backend Production",
      "command": "npm run start --prefix backend",
      "port": "5050"
    },
    {
      "name": "Serve Frontend Production",
      "command": "npm start --prefix frontend",
      "port": "3000"
    }
  ],
  "cleanupFiles": [
    "frontend/node_modules",
    "backend/node_modules",
    "frontend/.next",
    "backend/prisma/.prisma"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "backend",
      "path": "backend/.env"
    },
    {
      "name": "frontend",
      "path": "frontend/.env.local"
    }
  ]
}